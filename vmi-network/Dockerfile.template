# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template

COPY vmi-network/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY vmi-network/run.sh ${ROOT_FOLDER}/run.sh
COPY vmi-network/vmi-network-chaos.yml.template ${ROOT_FOLDER}/vmi-network-chaos.yml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="false"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="VMI Network Chaos"
LABEL krknctl.description="This scenario injects network degradation into a KubeVirt VirtualMachineInstance (VMI) by applying tc traffic control rules to simulate latency, packet loss, or bandwidth restrictions on the VMI's network interface. More information can be found at https://krkn-chaos.dev/docs/scenarios/network-chaos-ng-scenarios/vmi-network/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
