# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY storage-throttle/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY storage-throttle/run.sh ${ROOT_FOLDER}/run.sh
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh
COPY storage-throttle/storage_throttle.yaml.template ${ROOT_FOLDER}/storage_throttle.yaml.template

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Storage I/O Throttle"
LABEL krknctl.description="This scenario applies read/write IOPS and bandwidth throttling to a pod volume using cgroups v1/v2 through a privileged helper pod. More information can be found at https://krkn-chaos.dev/docs/scenarios/storage-throttle/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
