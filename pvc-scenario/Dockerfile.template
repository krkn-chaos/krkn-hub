# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY pvc-scenario/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY pvc-scenario/run.sh ${ROOT_FOLDER}/run.sh
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh
COPY pvc-scenario/pvc_scenario.yaml.template ${ROOT_FOLDER}/pvc_scenario.yaml.template

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="PVC Disk Fill"
LABEL krknctl.description="This scenario fills up a given PersistenVolumeClaim by creating a temp file on the PVC from a pod associated with it. \
The purpose of this scenario is to fill up a volume to understand faults cause by the application using this volume. \
For more information refer the following documentation (https://krkn-chaos.dev/docs/scenarios/pvc-scenario/)."

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
