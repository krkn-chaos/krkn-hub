# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY container-scenarios/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY container-scenarios/run.sh ${ROOT_FOLDER}/run.sh
COPY container-scenarios/container_scenario.yaml.template ${ROOT_FOLDER}/container_scenario.yaml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh
USER krkn

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="false"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Container Scenarios"
LABEL krknctl.description="Scenario to kill a container in a pod and see the effect it has on other services running and see how long it takes to get back running. More information can be found at https://krkn-chaos.dev/docs/scenarios/container-scenarios/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
