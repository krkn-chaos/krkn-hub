# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY service-disruption-scenarios/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY service-disruption-scenarios/run.sh ${ROOT_FOLDER}/run.sh
COPY service-disruption-scenarios/namespace_scenario.yaml.template ${ROOT_FOLDER}/namespace_scenario.yaml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="false"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Service Disruption"
LABEL krknctl.description="Using this type of scenario configuration one is able to delete crucial objects in a specific namespace, \
or a namespace matching a certain regex string. For more details documentation can be found here \
https://krkn-chaos.dev/docs/scenarios/service-disruption-scenarios/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
