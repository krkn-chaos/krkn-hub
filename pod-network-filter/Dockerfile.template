# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template

COPY pod-network-filter/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY pod-network-filter/run.sh ${ROOT_FOLDER}/run.sh
COPY pod-network-filter/network-filter.yml.template ${ROOT_FOLDER}/network-filter.yml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="false"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Pod Network Filter"
LABEL krknctl.description="This scenario will create iptables rules on the target pod to block incoming/outgoing traffic on specified ports and interfaces. More information can be found at https://krkn-chaos.dev/docs/scenarios/network-chaos-ng-scenarios/pod-network-filter/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh

