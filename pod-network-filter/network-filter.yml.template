- id: pod_network_filter
  wait_duration: 0
  test_duration: $TEST_DURATION
  label_selector: "$POD_SELECTOR"
  service_account: "$SERVICE_ACCOUNT"
  namespace: "$NAMESPACE"
  instance_count: $INSTANCE_COUNT
  execution: $EXECUTION
  ingress: $INGRESS
  egress: $EGRESS
  target: "$POD_NAME"
  interfaces: $INTERFACES_YAML
  ports: $PORTS_YAML
  taints: $TAINTS_YAML
  protocols: $PROTOCOLS_YAML
  image: "$IMAGE"
