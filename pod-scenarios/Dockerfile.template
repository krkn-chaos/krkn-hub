# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY pod-scenarios/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY pod-scenarios/run.sh ${ROOT_FOLDER}/run.sh
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh
COPY pod-scenarios/pod_scenario.yaml.template ${ROOT_FOLDER}/pod_scenario.yaml.template
COPY pod-scenarios/pod_scenario_namespace.yaml.template ${ROOT_FOLDER}/pod_scenario_namespace.yaml.template

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="false"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Pod Failures"
LABEL krknctl.description="This scenario disrupts the pods matching the label in the specified namespace on a Kubernetes/OpenShift cluster. More information can be found at https://krkn-chaos.dev/docs/scenarios/pod-scenarios/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
