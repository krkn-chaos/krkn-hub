# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations

COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY syn-flood/env.sh ${ROOT_FOLDER}/env.sh
COPY syn-flood/build_config_file.py ${ROOT_FOLDER}/build_config_file.py
COPY syn-flood/syn-flood.yaml.template ${ROOT_FOLDER}/syn-flood.yaml.template
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY syn-flood/run.sh ${ROOT_FOLDER}/run.sh
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Syn flood"
LABEL krknctl.description="This scenario simulates a user-defined surge of TCP SYN requests directed at one or more services deployed \
within the cluster or an external target reachable by the cluster. For more details, please refer to \
the following documentation (https://krkn-chaos.dev/docs/scenarios/syn-flood/)."


LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
