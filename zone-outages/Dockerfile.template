# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY zone-outages/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY zone-outages/run.sh ${ROOT_FOLDER}/run.sh
COPY zone-outages/zone_outage_scenario.yaml.template ${ROOT_FOLDER}/zone_outage_scenario.yaml.template
COPY zone-outages/zone_outage_scenario_gcp.yaml.template ${ROOT_FOLDER}/zone_outage_scenario_gcp.yaml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Zone outage"
LABEL krknctl.description="This scenario disrupts a targeted zone in the public cloud by blocking egress and ingress traffic \
to understand the impact on both Kubernetes/OpenShift platforms control plane as well as applications running on the worker \
nodes in that zone. More information is documented here https://krkn-chaos.dev/docs/scenarios/zone-outages/"


LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
