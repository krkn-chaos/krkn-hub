# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template

COPY node-interface-down/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY node-interface-down/run.sh ${ROOT_FOLDER}/run.sh
COPY node-interface-down/node-interface-down.yml.template ${ROOT_FOLDER}/node-interface-down.yml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="true"
LABEL krknctl.has_rollback="false"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Node Interface Down"
LABEL krknctl.description="This scenario brings down one or more network interfaces on target nodes to simulate a network outage. A workload pod is scheduled on each target node, the specified interfaces are taken down for the configured duration, then recovered automatically. The node's readiness is monitored after recovery. More information can be found at https://krkn-chaos.dev/docs/scenarios/network-chaos-ng-scenarios/node-interface-down/"
LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
