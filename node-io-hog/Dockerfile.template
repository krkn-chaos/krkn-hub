# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY node-io-hog/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY node-io-hog/run.sh ${ROOT_FOLDER}/run.sh
COPY node-io-hog/io-hog.yml.template ${ROOT_FOLDER}/io-hog.yml.template
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="true"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="I/O Hog"
LABEL krknctl.description="The purpose of this scenario is to create disk pressure on a particular node of the Kubernetes/OpenShift cluster for a time span. The scenario allows to attach a node path to the pod as a hostPath volume. More information can be found at https://krkn-chaos.dev/docs/scenarios/hog-scenarios/node-io-hog/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'


ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
