# Dockerfile for the VMI PVC Fill scenario

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY vmi-pvc-fill/env.sh ${ROOT_FOLDER}/env.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh
COPY vmi-pvc-fill/run.sh ${ROOT_FOLDER}/run.sh
COPY common_run.sh ${ROOT_FOLDER}/common_run.sh
COPY vmi-pvc-fill/vmi_pvc_fill.yaml.template ${ROOT_FOLDER}/vmi_pvc_fill.yaml.template

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="VMI PVC Fill"
LABEL krknctl.description="Fills a PVC attached to a KubeVirt VMI, either through a filesystem mount or from inside the guest for block volumes. Formatting a block device erases its existing data. More information: https://krkn-chaos.dev/docs/scenarios/vmi-pvc-fill/"

LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
