- id: node_network_filter
  wait_duration: 0
  test_duration: $TEST_DURATION
  label_selector: "$LABEL_SELECTOR"
  service_account: "$SERVICE_ACCOUNT"
  namespace: "$NAMESPACE"
  instance_count: $INSTANCE_COUNT
  execution: $EXECUTION
  ingress: $INGRESS
  egress: $EGRESS
  target: "$NODE_NAME"
  interfaces: ${INTERFACES_YAML}
  ports: [${PORTS}]
  taints: [${TAINTS}]
  protocols: [${PROTOCOLS}]
  image: "$IMAGE"
