# Dockerfile for kraken

FROM quay.io/krkn-chaos/krkn:latest

ENV ROOT_FOLDER /home/krkn
ENV KUBECONFIG ${ROOT_FOLDER}/.kube/config

# Copy configurations
COPY config.yaml.template ${ROOT_FOLDER}/config.yaml.template
COPY service-hijacking/env.sh ${ROOT_FOLDER}/env.sh
COPY service-hijacking/run.sh ${ROOT_FOLDER}/run.sh
COPY env.sh ${ROOT_FOLDER}/main_env.sh


COPY service-hijacking/config-schema.json ${ROOT_FOLDER}/service-hijacking-schema.json
COPY service-hijacking/validate_config.py ${ROOT_FOLDER}/validate_config.py

COPY common_run.sh ${ROOT_FOLDER}/common_run.sh

LABEL krknctl.is_a_scenario="true"
LABEL krknctl.privileged="false"
LABEL krknctl.has_rollback="true"
LABEL krknctl.kubeconfig_path="/home/krkn/.kube/config"
LABEL krknctl.title="Service Hijacking"
LABEL krknctl.description="Service Hijacking Scenarios aim to simulate fake HTTP responses from a workload targeted \
by a Service already deployed in the cluster. This scenario is executed by deploying a custom-made web service and \
modifying the target Service selector to direct traffic to this web service for a specified duration.\
Please refer to the documentation for the scenario file syntax https://krkn-chaos.dev/docs/scenarios/service-hijacking/"


LABEL krknctl.input_fields='$KRKNCTL_INPUT'

ENTRYPOINT /home/krkn/kraken/containers/setup-ssh.sh && ${ROOT_FOLDER}/run.sh
